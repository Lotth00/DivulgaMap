# Banco na nuvem (Neon). Se esta linha existir, as DB_* abaixo são ignoradas.
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

# Só para um Postgres local (deixe a DATABASE_URL de fora para usar estas)
