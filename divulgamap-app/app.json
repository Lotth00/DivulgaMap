{
  "expo": {
    "name": "DivulgaMap",
    "slug": "divulgamap-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icone.png",
    "scheme": "divulgamapapp",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D0FF96",
        "foregroundImage": "./assets/images/icone-adaptavel.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.loth00.divulgamapapp",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icone.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O DivulgaMap usa a sua localização para mostrar empresas e ofertas perto de você."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O DivulgaMap usa as suas fotos para a foto de perfil, as fotos da empresa e as das avaliações.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "418d1e9f-f2eb-438f-a86f-256cc9595ad8"
      }
    }
  }
}
